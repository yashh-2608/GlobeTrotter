# Copy to backend/.env. Use the Supabase Connect panel's PostgreSQL URL.
# For an IPv4 workstation, choose the session pooler (port 5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
# Optional dedicated direct/session connection for migrations:
# DIRECT_URL=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=4000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
