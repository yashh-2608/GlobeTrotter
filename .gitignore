# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
frontend/.next/
frontend/out/

# production
/build
backend/dist/

# misc
.DS_Store
*.pem

# local Claude tooling
.claude/
CLAUDE.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
frontend/.env*
backend/.env*
!backend/.env.example
!frontend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
backend/generated/

# stray local db artifact, unrelated to the Postgres schema
/dev.db
